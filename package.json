{
  "name": "myplayer",
  "version": "1.2.17",
  "description": "A black and white Liquid Glass desktop music and video player",
  "main": "src/main.cjs",
  "author": "MyPlayer",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron . --player=music",
    "start:music": "electron . --player=music",
    "prestart:cinema": "node scripts/ensure-mpv.cjs",
    "start:cinema": "electron . --player=cinema",
    "postinstall": "node scripts/patch-mpv-tracks.cjs",
    "build:mpv": "npm run build:native --prefix node_modules/electron-mpv-video",
    "predist": "npm run build:mpv",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-mpv-video": "^0.1.1",
    "music-metadata": "^11.9.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.2.0"
  },
  "build": {
    "appId": "com.myplayer.desktop",
    "productName": "MyPlayer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "node_modules/music-metadata/**/*",
      "node_modules/electron-mpv-video/**/*",
      "node_modules/node-addon-api/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/mymusicplayer.ico",
        "to": "mymusicplayer.ico"
      },
      {
        "from": "assets/mycinema.ico",
        "to": "mycinema.ico"
      }
    ],
    "asarUnpack": [
      "node_modules/electron-mpv-video/native/mpv-addon/build/Release/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "artifactName": "MyPlayer-Setup-${version}.${ext}",
      "icon": "assets/mymusicplayer.ico"
    },
    "nsis": {
      "include": "scripts/register-default-apps.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false
    }
  },
  "allowScripts": {
    "electron@45.1.0": true
  },
  "overrides": {
    "node-gyp": "^12.2.0"
  }
}
